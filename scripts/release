#!/bin/bash
#
# Publish a release only when its marker is valid for the current release branch.
# `main` publishes stable releases; `snapshot` publishes Maven snapshots.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "${SCRIPT_DIR}/inc.functions.sh"

function current_branch() {
  # CI checks out the triggering SHA, which leaves HEAD detached.
  if [[ -n "${RELEASE_BRANCH:-}" ]]; then
    printf '%s\n' "${RELEASE_BRANCH}"
  else
    git rev-parse --abbrev-ref HEAD
  fi
}

function is_release_commit() {
  local commit_message
  commit_message=$(git log --format=%B -n 1 "$1" | head -n 1)
  [[ "${commit_message}" == "release v"* ]]
}

function contains_snapshot() {
  local commit_message
  commit_message=$(git log --format=%B -n 1 "$1" | head -n 1)
  local version="${commit_message#release v}"
  version="${version%% *}"
  [[ "${version}" == *-SNAPSHOT ]]
}

function is_release_commit_for_branch() {
  local branch="$1"
  local commit="$2"

  if ! is_release_commit "${commit}"; then
    return 1
  fi

  if [[ "${branch}" == "snapshot" ]]; then
    contains_snapshot "${commit}"
  elif [[ "${branch}" == "main" ]]; then
    ! contains_snapshot "${commit}"
  else
    return 1
  fi
}

function validate_release_for_branch() {
  local branch="$1"
  local commit="$2"

  if [[ "${branch}" == "snapshot" ]]; then
    if ! contains_snapshot "${commit}"; then
      die "Stable releases are not allowed on snapshot branch."
    fi
  elif [[ "${branch}" == "main" ]]; then
    if contains_snapshot "${commit}"; then
      die "Snapshot releases are not allowed on main."
    fi
  else
    die "Unsupported release branch: ${branch}"
  fi
}

function publish_commit() {
  local branch="$1"
  local release_commit="$2"
  local trusted_commit="$3"

  validate_release_for_branch "${branch}" "${release_commit}"

  if [[ "$(git rev-parse HEAD)" != "${trusted_commit}" ]]; then
    die "Trusted release commit is not currently checked out."
  fi
  if [[ -n "${EXPECTED_RELEASE_SHA:-}" && "${trusted_commit}" != "${EXPECTED_RELEASE_SHA}" ]]; then
    die "Checked out commit does not match the CI release SHA."
  fi

  local commit_message marker_version version channel
  commit_message=$(git log --format=%B -n 1 "${release_commit}" | head -n 1)
  marker_version="${commit_message#release v}"
  marker_version="${marker_version%% *}"
  version=$(get_version_name gradle.properties)
  if [[ "${version}" != "${marker_version}" ]]; then
    die "Release marker ${marker_version} does not match checked-out SDK version ${version}."
  fi

  approve "Release marker found at ${release_commit} on branch ${branch}; publishing trusted HEAD ${trusted_commit}..."
  safe chmod +x ./gradlew
  safe ./gradlew generateApolloSources

  if contains_snapshot "${release_commit}"; then
    channel=snapshot
    approve "Snapshot release, publishing snapshot artifact..."
    safe ./gradlew publishToMavenCentral
  else
    channel=stable
    approve "Stable release, publishing to Maven Central..."
    safe ./gradlew publishAndReleaseToMavenCentral --no-configuration-cache
  fi

  # Downstream publication is eligible only after Maven publication succeeds.
  if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
    printf 'published=true\nversion=%s\nchannel=%s\nsource_revision=%s\n' \
      "${version}" "${channel}" "${trusted_commit}" >> "${GITHUB_OUTPUT}"
  fi
}

if [[ -n "${GITHUB_OUTPUT:-}" ]]; then
  printf 'published=false\n' >> "${GITHUB_OUTPUT}"
fi

git_head_commit=$(git rev-parse HEAD)
git_branch=$(current_branch)
git_last_merge_commit=$(git log -1 --format=%H --merges || true)

if [[ "${git_branch}" != "main" && "${git_branch}" != "snapshot" ]]; then
  warn "Current branch (${git_branch}) is not releasable, skipping..."
  exit 0
fi

if [[ -n "${git_last_merge_commit}" && "${git_head_commit}" == "${git_last_merge_commit}" ]]; then
  approve "HEAD is a merge commit, scanning merged branch for release commits..."

  git_branch_parent_commits=($(git log -1 --merges --pretty=format:%P))
  git_branch_merge_base_commit=$(git merge-base --all "${git_branch_parent_commits[0]}" "${git_branch_parent_commits[1]}")

  for commit in $(git log --pretty=%H "${git_branch_merge_base_commit}..${git_branch_parent_commits[1]}"); do
    if is_release_commit_for_branch "${git_branch}" "${commit}"; then
      publish_commit "${git_branch}" "${commit}" "${git_head_commit}"
      exit 0
    fi
  done
elif is_release_commit "${git_head_commit}"; then
  publish_commit "${git_branch}" "${git_head_commit}" "${git_head_commit}"
  exit 0
fi

warn "No release commit, skipping..."
